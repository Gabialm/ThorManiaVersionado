<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Perdi um Pet</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">
    <!-- Cadastro do pet? desaparecido? -->
    <h2>Cadastro do desaparecido</h2>

    <form>
        <label for="foto">Foto do pet (recente):</label>
        <input type="file" id="foto" accept="image/*" onchange="previewImagem(event)">

        <div class="preview">
            <img id="imagemPreview" src="" alt="">
        </div>

        <label for="nome">Nome:</label>
        <input type="text" id="nome" placeholder="Digite o nome">

        <label for="raca">Raça:</label>
        <input type="text" id="raca" placeholder="Digite a raça">

        <label for="peso">Peso (kg):</label>
        <input type="number" id="peso" placeholder="Ex: 10">

        <label for="descricao">Descrição:</label>
        <textarea id="descricao" rows="4" placeholder="Detalhes do animal..."></textarea>

        <!-- nome e contato é melhor ser separado, acho -->
        <label for="dono">Nome do Dono:</label>
        <input type="text" id="dono" placeholder="Digite o nome do dono">

        <!-- contato do dono -->
        <label for="contato">Contato:</label>
        <input type="text" id="contato" placeholder="Telefone ou email do dono">

        <button type="submit">Enviar!</button>
    </form>
</div>

<script>
function previewImagem(event) {
    const imagem = document.getElementById('imagemPreview');
    imagem.src = URL.createObjectURL(event.target.files[0]);
}
</script>

</body>
</html>